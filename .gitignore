# OS / editor
.DS_Store
Thumbs.db
*.swp
*~

# IDE (keep shared run configs if you add them later)
.idea/
*.iml
.vscode/
*.code-workspace

# --- Android (see also android/.gitignore) ---
android/local.properties
android/.gradle/
android/**/build/
android/captures/
android/.externalNativeBuild/
android/.cxx/
android/*.apk
android/*.aab
android/*.ap_
android/*.dex

# Signing keys — never commit
*.jks
*.keystore
*.p12
key.properties
android/keystore.properties

# --- Backend / server (secrets & runtime) ---
backend/.env
backend/.env.*
backend/venv/
backend/.venv/
backend/**/__pycache__/
backend/**/*.py[cod]
backend/.pytest_cache/
backend/.mypy_cache/
backend/*.db
backend/**/*.db
backend/appblocker.db

# --- Dashboard (web UI for backend) ---
dashboard/node_modules/
dashboard/dist/
dashboard/.env
dashboard/.env.*

# Keep server/admin code local only (safe for future public repo)
backend/
dashboard/

# Misc
*.log
*.tmp
