<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_block_overlay"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_block_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingVertical="32dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/survival_accessibility_overlay_title"
            android:src="@drawable/ic_stat_monitor" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/survival_accessibility_overlay_title"
            android:textAppearance="@style/TextAppearance.Appbllocker.BlockHeadline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/survival_accessibility_overlay_message"
            android:textAppearance="@style/TextAppearance.Appbllocker.BlockMessage" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenAccessibility"
            style="@style/Widget.Appbllocker.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/survival_accessibility_overlay_button" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/survival_accessibility_overlay_footer"
            android:textAppearance="@style/TextAppearance.Appbllocker.BlockReset" />
    </LinearLayout>
</FrameLayout>
