<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_block_overlay"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_block_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingVertical="32dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/block_title"
            android:src="@drawable/ic_block_lock" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/block_title"
            android:textAppearance="@style/TextAppearance.Appbllocker.BlockHeadline" />

        <TextView
            android:id="@+id/blockedAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Appbllocker.BlockAppName"
            tools:text="Chrome" />

        <View
            android:layout_width="120dp"
            android:layout_height="2dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_block_divider" />

        <TextView
            android:id="@+id/blockMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/block_message_time_limit"
            android:textAppearance="@style/TextAppearance.Appbllocker.BlockMessage" />

        <TextView
            android:id="@+id/resetTimeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Appbllocker.BlockReset"
            tools:text="Сброс через 5ч 30мин" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoHome"
            style="@style/Widget.Appbllocker.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/app_password_go_home" />

    </LinearLayout>

</FrameLayout>
