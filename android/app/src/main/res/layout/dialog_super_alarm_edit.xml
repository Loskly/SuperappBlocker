<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/super_alarm_edit_title"
            android:textAppearance="@style/TextAppearance.Appbllocker.Section" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/super_alarm_label_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/labelInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickTime"
            style="@style/Widget.Appbllocker.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/super_alarm_pick_time" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/super_alarm_repeat_days"
            android:textAppearance="@style/TextAppearance.Appbllocker.Section" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/daysChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMon"
                style="@style/Widget.Appbllocker.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/super_alarm_day_mon" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTue"
                style="@style/Widget.Appbllocker.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/super_alarm_day_tue" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWed"
                style="@style/Widget.Appbllocker.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/super_alarm_day_wed" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipThu"
                style="@style/Widget.Appbllocker.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/super_alarm_day_thu" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFri"
                style="@style/Widget.Appbllocker.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/super_alarm_day_fri" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSat"
                style="@style/Widget.Appbllocker.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/super_alarm_day_sat" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSun"
                style="@style/Widget.Appbllocker.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/super_alarm_day_sun" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/super_alarm_difficulty"
            android:textAppearance="@style/TextAppearance.Appbllocker.Section" />

        <RadioGroup
            android:id="@+id/difficultyGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/radioEasy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/super_alarm_difficulty_easy" />

            <RadioButton
                android:id="@+id/radioMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/super_alarm_difficulty_medium" />

            <RadioButton
                android:id="@+id/radioHard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/super_alarm_difficulty_hard" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/super_alarm_sound"
            android:textAppearance="@style/TextAppearance.Appbllocker.Section" />

        <TextView
            android:id="@+id/soundNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/on_surface_variant"
            tools:text="Системный будильник" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickSound"
            style="@style/Widget.Appbllocker.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/super_alarm_pick_sound" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetSound"
            style="@style/Widget.Appbllocker.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/super_alarm_sound_reset"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/super_alarm_volume"
            android:textAppearance="@style/TextAppearance.Appbllocker.Section" />

        <com.google.android.material.slider.Slider
            android:id="@+id/volumeSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:valueFrom="10"
            android:valueTo="100" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/volumeGuardSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/super_alarm_volume_guard"
            android:textColor="@color/on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTry"
            style="@style/Widget.Appbllocker.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/super_alarm_try" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.Appbllocker.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
