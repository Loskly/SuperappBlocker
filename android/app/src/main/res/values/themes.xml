    <style name="Theme.Appbllocker.BlockOverlay" parent="Theme.Material3.Dark.NoActionBar">

        <item name="android:windowFullscreen">true</item>

        <item name="android:windowShowWallpaper">false</item>

        <item name="android:windowBackground">@drawable/bg_block_overlay</item>

        <item name="android:colorBackground">@color/block_background</item>

        <item name="colorPrimary">@color/neon_primary</item>

        <item name="colorSecondary">@color/neon_secondary</item>

        <item name="colorOnSurface">@color/on_surface</item>

        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <item name="colorOnBackground">@color/on_surface</item>

        <item name="android:textColorPrimary">@color/on_surface</item>

        <item name="android:textColorSecondary">@color/on_surface_variant</item>

        <item name="android:statusBarColor">@color/block_background</item>

        <item name="android:navigationBarColor">@color/block_background</item>

        <item name="android:windowLightStatusBar">false</item>

        <item name="android:windowLightNavigationBar">false</item>

    </style>



    <style name="ThemeOverlay.Appbllocker.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">

        <item name="colorSurface">@color/surface</item>

