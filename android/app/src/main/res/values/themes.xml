    <style name="TextAppearance.Appbllocker.LabelMedium" parent="TextAppearance.Material3.LabelMedium">

        <item name="android:textColor">@color/on_surface_variant</item>

    </style>



    <style name="TextAppearance.Appbllocker.LabelSmall" parent="TextAppearance.Material3.LabelSmall">

        <item name="android:textColor">@color/on_surface_variant</item>

    </style>



    <style name="TextAppearance.Appbllocker.BlockHeadline" parent="TextAppearance.Material3.HeadlineLarge">

        <item name="android:textSize">32sp</item>

        <item name="android:textColor">@color/block_accent</item>

        <item name="android:textStyle">bold</item>

        <item name="android:letterSpacing">0.02</item>

    </style>



    <style name="TextAppearance.Appbllocker.BlockAppName" parent="TextAppearance.Material3.HeadlineMedium">

        <item name="android:textSize">28sp</item>

        <item name="android:textColor">@color/neon_primary</item>

        <item name="android:textStyle">bold</item>

    </style>



    <style name="TextAppearance.Appbllocker.BlockMessage" parent="TextAppearance.Material3.BodyLarge">

        <item name="android:textSize">20sp</item>

        <item name="android:textColor">@color/on_surface</item>

        <item name="android:lineSpacingExtra">4dp</item>

    </style>



    <style name="TextAppearance.Appbllocker.BlockReset" parent="TextAppearance.Material3.BodyMedium">

        <item name="android:textSize">18sp</item>

        <item name="android:textColor">@color/neon_secondary</item>

    </style>



    <style name="Widget.Appbllocker.Card" parent="Widget.Material3.CardView.Elevated">

        <item name="cardBackgroundColor">@color/surface</item>

        <item name="cardCornerRadius">16dp</item>

        <item name="cardElevation">0dp</item>

        <item name="strokeColor">@color/neon_glow</item>

        <item name="strokeWidth">1dp</item>

    </style>



    <style name="Widget.Appbllocker.Button" parent="Widget.Material3.Button">

        <item name="backgroundTint">@color/button_background</item>

        <item name="android:textColor">@color/button_on_primary</item>

        <item name="cornerRadius">12dp</item>

    </style>



    <style name="Widget.Appbllocker.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">

        <item name="strokeColor">@color/button_outlined_stroke</item>

        <item name="android:textColor">@color/button_outlined_text</item>

        <item name="cornerRadius">12dp</item>

    </style>



    <style name="Widget.Appbllocker.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">

        <item name="thumbTint">@color/neon_primary</item>

        <item name="trackTint">@color/surface_variant</item>

    </style>



