        <item name="android:textColor">@color/on_surface</item>

        <item name="buttonTint">@color/radio_button_tint</item>

    </style>



    <style name="Widget.Appbllocker.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">

        <item name="boxStrokeColor">@color/text_input_stroke_color</item>

        <item name="hintTextColor">@color/on_surface_variant</item>

        <item name="android:textColorHint">@color/on_surface_variant</item>

        <item name="boxBackgroundColor">@color/surface_variant</item>

        <item name="boxStrokeWidth">1dp</item>

        <item name="boxStrokeWidthFocused">2dp</item>

        <item name="editTextStyle">@style/Widget.Appbllocker.TextInputEditText</item>

    </style>



